# Application
PORT=3000
NODE_ENV=development

# The current persistence adapter stores JSON files; this path is relative to
# the directory where the application is started.
DB_DATA_DIR=./db/data

# SMTP settings are required for email verification. Obtain these from your
# email provider; do not commit real credentials.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM=

# Optional keys for creating staff or administrator accounts.
STAFF_REGISTRATION_PASSCODE=
ADMIN_REGISTRATION_PASSCODE=
